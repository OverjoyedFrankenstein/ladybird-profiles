+TEST_CASE(named_profile_listing)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+
+    // Nothing is listed before any profile has been created.
+    EXPECT(MUST(WebView::Profile::named_profiles(profile_roots)).is_empty());
+
+    auto work = MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "banking-2" }, profile_roots));
+
+    // A directory whose name could not be a profile's, and a file, are not profiles.
+    auto profiles_directory = LexicalPath::join(profile_roots.data, "Ladybird/Profiles"sv).string();
+    MUST(Core::Directory::create(LexicalPath::join(profiles_directory, "Not.A.Profile"sv), Core::Directory::CreateDirectories::Yes));
+    auto stray_file = MUST(Core::File::open(LexicalPath::join(profiles_directory, "stray"sv).string(), Core::File::OpenMode::Write));
+    stray_file->close();
+
+    auto names = MUST(WebView::Profile::named_profiles(profile_roots));
+    EXPECT_EQ(names, (Vector<ByteString> { "banking-2", "personal", "work" }));
+
+    EXPECT_EQ(MUST(WebView::Profile::identity_of_named_profile(profile_roots, "work"sv)), work.paths().identity);
+    EXPECT(WebView::Profile::identity_of_named_profile(profile_roots, "missing"sv).is_error());
+    EXPECT(WebView::Profile::identity_of_named_profile(profile_roots, "../work"sv).is_error());
