+static ErrorOr<Vector<ByteString>> existing_profile_names()
+{
+    auto roots = TRY(WebView::Profile::platform_roots());
+    return WebView::Profile::named_profiles(roots);
+}
+
+static bool is_running_with_named_profile(ByteString const& profile_identity, StringView name)
+{
+    auto roots = WebView::Profile::platform_roots();
+    if (roots.is_error())
+        return false;
+    auto identity = WebView::Profile::identity_of_named_profile(roots.value(), name);
+    return !identity.is_error() && identity.value() == profile_identity;
+}
+
+void Application::populate_profiles_menu(QMenu& menu)
+{
+    menu.clear();
+
+    auto names = existing_profile_names();
+    if (names.is_error())
+        warnln("Unable to list Ladybird profiles: {}", names.error());
+
+    auto roots = WebView::Profile::platform_roots();
+    auto primary_name = roots.is_error() ? ByteString { WebView::DEFAULT_PROFILE_NAME } : WebView::Profile::primary_profile_name(roots.value());
+
+    // Each profile is listed above the item that creates one, so every new profile pushes that item down.
+    if (!names.is_error() && !names.value().is_empty()) {
+        for (auto const& name : names.value()) {
+            // The primary profile is the one Ladybird starts with, which is chosen below or in the settings.
+            auto title = name == primary_name ? qformatted("{} (Primary)", name) : qstring_from_ak_string(name);
+            auto* action = menu.addAction(title);
+            action->setCheckable(true);
+            action->setChecked(is_running_with_named_profile(m_profile_identity, name));
+            QObject::connect(action, &QAction::triggered, &menu, [name] {
+                Application::the().open_profile(name);
+            });
+        }
+        menu.addSeparator();
+
+        auto* primary_menu = menu.addMenu("&Primary Profile");
+        auto* primary_group = new QActionGroup(primary_menu);
+        primary_group->setExclusive(true);
+        for (auto const& name : names.value()) {
+            auto* action = primary_menu->addAction(qstring_from_ak_string(name));
+            action->setCheckable(true);
+            action->setChecked(name == primary_name);
+            primary_group->addAction(action);
+            QObject::connect(action, &QAction::triggered, &menu, [name] {
+                Application::the().set_primary_profile(name);
+            });
+        }
+    }
+
+    auto* create_action = menu.addAction("&Create…");
+    QObject::connect(create_action, &QAction::triggered, &menu, [] {
+        Application::the().show_create_profile_dialog();
+    });
+}
+
+void Application::set_primary_profile(ByteString const& name)
+{
+    auto set_primary = [&]() -> ErrorOr<void> {
+        auto roots = TRY(WebView::Profile::platform_roots());
+        return WebView::Profile::set_primary_profile_name(roots, name);
+    };
+    if (auto result = set_primary(); result.is_error())
+        QMessageBox::warning(active_window_if_any(), "Unable to set the primary profile", qformatted("Ladybird could not make \"{}\" the primary profile: {}", name, result.error()));
+
+    // The menu is filled in as it opens, but on macOS it may already have been laid out for the menu bar.
+    if (auto* menu = profiles_menu())
+        populate_profiles_menu(*menu);
+}
+
+void Application::show_create_profile_dialog()
+{
+    auto names = existing_profile_names();
+    if (names.is_error()) {
+        warnln("Unable to list Ladybird profiles: {}", names.error());
+        names = Vector<ByteString> {};
+    }
+
+    auto* parent = active_window_if_any();
+    auto* dialog = new ProfileDialog(parent, names.release_value());
+
+    QObject::connect(dialog, &QDialog::finished, [parent = QPointer<QWidget> { parent }, dialog = QPointer { dialog }](auto result) {
+        if (result != QDialog::Accepted || !dialog)
+            return;
+
+        auto name = dialog->profile_name();
+        auto create_profile = [&]() -> ErrorOr<void> {
+            auto roots = TRY(WebView::Profile::platform_roots());
+            // NB: Creating the profile would take the mark away from one that was deleted while it was open, and keep it.
+            if (WebView::Profile::is_named_profile_marked_for_removal(roots, name) && WebView::Profile::remove_named_profile(roots, name).is_error())
+                return Error::from_string_literal("A profile with that name is still being deleted. Try again in a moment");
+            // NB: The profile's directories are all that make it exist. It is opened once it is chosen from the menu.
+            (void)TRY(WebView::Profile::create({ .name = name }, roots));
+            return {};
+        };
+        if (auto result = create_profile(); result.is_error()) {
+            QMessageBox::warning(parent, "Unable to create profile", qformatted("Ladybird could not create the profile \"{}\": {}", name, result.error()));
+            return;
+        }
+
+        // The menu is filled in as it opens, but on macOS it may already have been laid out for the menu bar.
+        if (auto* menu = Application::the().profiles_menu())
+            Application::the().populate_profiles_menu(*menu);
+    });
+
+    dialog->open();
+}
+
+void Application::open_profile(ByteString const& name)
+{
+    if (is_running_with_named_profile(m_profile_identity, name)) {
+        open_new_window(WebView::IsPrivate::No);
+        return;
+    }
+
+    // NB: Each profile runs in a Ladybird of its own. If one is running with the profile already, the new one hands it
+    //     a request to open a window, and ends.
+    if (m_restart_command.executable.is_empty()) {
+        warnln("Unable to open the profile \"{}\": the path of the Ladybird executable is unknown", name);
+        return;
+    }
+
+    auto executable = qstring_from_ak_string(m_restart_command.executable);
+    auto arguments = QStringList { qformatted("--profile={}", name) };
+    if (!QProcess::startDetached(executable, arguments))
+        warnln("Unable to open the profile \"{}\": Ladybird could not be started", name);
+}
