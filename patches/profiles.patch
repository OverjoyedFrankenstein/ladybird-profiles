+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWebView/Profile.h>
+#include <UI/Qt/ChromeStyle.h>
+#include <UI/Qt/NativeTextEditingLineEdit.h>
+#include <UI/Qt/ProfileDialog.h>
+#include <UI/Qt/StringUtils.h>
+
+#include <QDialogButtonBox>
+#include <QEvent>
+#include <QFormLayout>
+#include <QLabel>
+#include <QPushButton>
+#include <QRegularExpressionValidator>
+
+namespace Ladybird {
+
+// Profile names become directory names, so they are kept short.
+static constexpr int MAXIMUM_PROFILE_NAME_LENGTH = 64;
+
+ProfileDialog::ProfileDialog(QWidget* parent, Vector<ByteString> existing_profile_names)
+    : QDialog(parent)
+    , m_existing_profile_names(AK::move(existing_profile_names))
+{
+    setAttribute(Qt::WA_DeleteOnClose);
+    setObjectName("LadybirdProfileDialog");
+    setWindowTitle("Create profile");
+
+    auto* layout = new QFormLayout(this);
+    layout->setContentsMargins(20, 18, 20, 18);
+    layout->setFieldGrowthPolicy(QFormLayout::ExpandingFieldsGrow);
+    layout->setHorizontalSpacing(16);
+    layout->setVerticalSpacing(12);
+
+    m_name_edit = new NativeTextEditingLineEdit(this);
+    m_name_edit->setMinimumWidth(280);
+    m_name_edit->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+    m_name_edit->setMaxLength(MAXIMUM_PROFILE_NAME_LENGTH);
+    m_name_edit->setPlaceholderText("work");
+    // Upper case letters are taken as they are typed, and become lower case, which is all a profile name may contain.
+    m_name_edit->setValidator(new QRegularExpressionValidator(QRegularExpression("[A-Za-z0-9_-]*"), m_name_edit));
+    connect(m_name_edit, &QLineEdit::textEdited, this, [this](QString const& text) {
+        auto lower_case_text = text.toLower();
+        if (lower_case_text != text) {
+            auto cursor_position = m_name_edit->cursorPosition();
+            m_name_edit->setText(lower_case_text);
+            m_name_edit->setCursorPosition(cursor_position);
+        }
+    });
+    connect(m_name_edit, &QLineEdit::textChanged, this, [this] { update_create_button(); });
+    layout->addRow("Name:", m_name_edit);
+
+    m_problem_label = new QLabel(this);
+    m_problem_label->setVisible(false);
+    layout->addRow(QString {}, m_problem_label);
+
+    auto* buttons = new QDialogButtonBox(QDialogButtonBox::Cancel, this);
+    m_create_button = buttons->addButton("Create", QDialogButtonBox::AcceptRole);
+    m_create_button->setDefault(true);
+    connect(buttons, &QDialogButtonBox::accepted, this, &QDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, this, &QDialog::reject);
+    layout->addRow(buttons);
+
+    update_create_button();
+    update_chrome_style();
+    resize(400, sizeHint().height());
+}
+
+ByteString ProfileDialog::profile_name() const
+{
+    return ak_byte_string_from_qstring(m_name_edit->text());
+}
+
+void ProfileDialog::update_create_button()
+{
+    auto name = profile_name();
+    auto is_taken = m_existing_profile_names.contains_slow(name);
+
+    if (is_taken)
+        m_problem_label->setText(qformatted("A profile named \"{}\" already exists.", name));
+    m_problem_label->setVisible(is_taken);
+    m_create_button->setEnabled(WebView::Profile::is_valid_name(name) && !is_taken);
+}
+
+bool ProfileDialog::event(QEvent* event)
+{
+    if (event->type() == QEvent::PaletteChange)
+        update_chrome_style();
+    return QDialog::event(event);
+}
+
+void ProfileDialog::update_chrome_style()
+{
+    if (m_is_updating_chrome_style)
+        return;
+
+    m_is_updating_chrome_style = true;
+    setStyleSheet(ChromeStyle::profile_dialog_style_sheet(palette()));
+    m_is_updating_chrome_style = false;
+}
+
+}
