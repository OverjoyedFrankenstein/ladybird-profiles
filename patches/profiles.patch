+
+// The process that wrote the profile's PID file, if it is still running. Only a Ladybird that is running with the
+// profile has a PID file there, as it removes the file when it ends. One that crashed leaves it behind.
+static Optional<i32> running_process_in_pid_file(ProfileRoots const& roots, StringView name)
+{
+    auto pid_path = LexicalPath::join(profile_path(roots.runtime, name), "Ladybird.pid"sv).string();
+    auto file = Core::File::open(pid_path, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return {};
+    auto contents = file.value()->read_until_eof();
+    if (contents.is_error())
+        return {};
+    auto pid = StringView { contents.value() }.trim_whitespace().to_number<i32>();
+    if (!pid.has_value() || *pid <= 0)
+        return {};
+#if defined(AK_OS_WINDOWS)
+    // FIXME: Find out whether the process is still running on Windows, rather than taking it to be.
+    return pid;
+#else
+    if (kill(*pid, 0) == 0 || errno == EPERM)
+        return pid;
+    return {};
+#endif
+}
+
+// NB: A PID file that can't be read is taken to belong to a running Ladybird, so that its profile is not changed.
+static bool browser_of_named_profile_is_running(ProfileRoots const& roots, StringView name)
+{
+    auto pid_path = LexicalPath::join(profile_path(roots.runtime, name), "Ladybird.pid"sv).string();
+    if (FileSystem::exists(pid_path)) {
+        auto file = Core::File::open(pid_path, Core::File::OpenMode::Read);
+        if (file.is_error() || file.value()->read_until_eof().is_error())
+            return true;
+    }
+    return running_process_in_pid_file(roots, name).has_value();
+}
+
+Optional<i32> Profile::browser_process_of_named_profile(ProfileRoots const& roots, StringView name)
+{
+    if (!is_valid_name(name))
+        return {};
+    return running_process_in_pid_file(roots, name);
+}
+
+// Takes the profile's startup lock, so that no Ladybird starts with it while it is changed, or fails if it is in use.
+static ErrorOr<ProfileStartupLock> lock_unused_named_profile(ProfileRoots const& roots, StringView name)
+{
+    if (!Profile::is_valid_name(name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+    if (!FileSystem::is_directory(profile_path(roots.data, name)))
+        return Error::from_string_literal("The profile does not exist");
+
+    auto lock = TRY(ProfileStartupLock::try_to_take(roots, name));
+    if (!lock.has_value() || browser_of_named_profile_is_running(roots, name))
+        return Error::from_string_literal("The profile is in use. Close the Ladybird that is using it first");
+    return lock.release_value();
+}
+
+ErrorOr<bool> Profile::is_named_profile_in_use(ProfileRoots const& roots, StringView name)
+{
+    if (!is_valid_name(name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+
+    auto lock = TRY(ProfileStartupLock::try_to_take(roots, name));
+    return !lock.has_value() || browser_of_named_profile_is_running(roots, name);
+}
+
+ErrorOr<void> Profile::rename_named_profile(ProfileRoots const& roots, StringView name, StringView new_name)
+{
+    if (!is_valid_name(new_name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+    if (name == new_name)
+        return {};
+
+    auto lock = TRY(lock_unused_named_profile(roots, name));
+
+    auto directories = directories_of_named_profile(roots, name);
+    auto new_directories = directories_of_named_profile(roots, new_name);
+    VERIFY(directories.size() == new_directories.size());
+
+    for (auto const& new_directory : new_directories) {
+        if (FileSystem::exists(new_directory))
+            return Error::from_string_literal("A profile with that name already exists");
+    }
+
+    // A profile is renamed as a whole or not at all, so the directories renamed before a failure are renamed back.
+    for (size_t i = 0; i < directories.size(); ++i) {
+        if (!FileSystem::exists(directories[i]))
+            continue;
+        if (auto result = Core::System::rename(directories[i], new_directories[i]); result.is_error()) {
+            for (size_t j = 0; j < i; ++j) {
+                if (FileSystem::exists(new_directories[j]))
+                    (void)Core::System::rename(new_directories[j], directories[j]);
+            }
+            return result.release_error();
+        }
+    }
+
+    // NB: The profile was renamed, so failing to keep it primary only makes the default profile primary again.
+    if (is_primary_profile_name(roots, name)) {
+        if (auto result = write_primary_profile_name(roots, new_name); result.is_error())
+            warnln("Unable to keep the renamed profile '{}' primary: {}", new_name, result.error());
+    }
+    return {};
+}
+
+ErrorOr<void> Profile::remove_named_profile(ProfileRoots const& roots, StringView name)
+{
+    auto lock = TRY(lock_unused_named_profile(roots, name));
+
+    // NB: The data directory goes last, as the profile is listed for as long as it exists. A removal that fails partway
+    //     leaves the profile listed, so that it can be removed again.
+    auto directories = directories_of_named_profile(roots, name);
+    auto data_directory = profile_path(roots.data, name);
+    directories.remove_all_matching([&](auto const& directory) { return directory == data_directory; });
+    directories.append(move(data_directory));
+
+    for (auto const& directory : directories) {
+        if (FileSystem::exists(directory))
+            TRY(FileSystem::remove(directory, FileSystem::RecursionMode::Allowed));
+    }
+
+    // A profile created later with the same name is a new profile, which is not primary.
+    if (is_primary_profile_name(roots, name)) {
+        if (auto result = forget_primary_profile_name(roots); result.is_error())
+            warnln("Unable to forget the deleted primary profile '{}': {}", name, result.error());
+    }
+    return {};
+}
+
+ErrorOr<void> Profile::mark_named_profile_for_removal(ProfileRoots const& roots, StringView name)
+{
+    if (!is_valid_name(name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+    if (!FileSystem::is_directory(profile_path(roots.data, name)))
+        return Error::from_string_literal("The profile does not exist");
+
+    auto marker = TRY(Core::File::open(removal_marker_path(roots.data, name), Core::File::OpenMode::Write));
+    marker->close();
+    return {};
+}
+
+ErrorOr<void> Profile::unmark_named_profile_for_removal(ProfileRoots const& roots, StringView name)
+{
+    if (!is_valid_name(name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+    if (auto marker = removal_marker_path(roots.data, name); FileSystem::exists(marker))
+        TRY(FileSystem::remove(marker, FileSystem::RecursionMode::Disallowed));
+    return {};
+}
+
+bool Profile::is_named_profile_marked_for_removal(ProfileRoots const& roots, StringView name)
+{
+    return is_valid_name(name) && FileSystem::exists(removal_marker_path(roots.data, name));
+}
+
+size_t Profile::remove_named_profiles_marked_for_removal(ProfileRoots const& roots)
+{
+    auto directory = profiles_directory(roots.data);
+    if (!FileSystem::is_directory(directory))
+        return 0;
+
+    Vector<ByteString> marked;
+    auto result = Core::Directory::for_each_entry(directory, Core::DirIterator::SkipDots, [&](Core::DirectoryEntry const& entry, Core::Directory const&) -> ErrorOr<IterationDecision> {
+        if (entry.type == Core::DirectoryEntry::Type::Directory && is_valid_name(entry.name) && FileSystem::exists(removal_marker_path(roots.data, entry.name)))
+            marked.append(entry.name);
+        return IterationDecision::Continue;
+    });
+    if (result.is_error())
+        return 0;
+
+    // NB: A profile that is still in use is refused, and is removed by a later call, once it was closed.
+    size_t removed = 0;
+    for (auto const& name : marked) {
+        if (!remove_named_profile(roots, name).is_error())
+            ++removed;
+    }
+    return removed;
+}
+
+ByteString Profile::primary_profile_name(ProfileRoots const& roots)
+{
+    auto name = read_primary_profile_name(roots);
+    if (name.is_error()) {
+        warnln("Unable to read the primary Ladybird profile: {}", name.error());
+        return DEFAULT_PROFILE_NAME;
+    }
+
+    // A profile that was deleted, or is to be deleted once it is closed, is not brought back.
+    if (!name.value().has_value() || !named_profile_exists(roots, *name.value()))
+        return DEFAULT_PROFILE_NAME;
+    return name.release_value().release_value();
+}
+
+ErrorOr<void> Profile::set_primary_profile_name(ProfileRoots const& roots, StringView name)
+{
+    if (!is_valid_name(name))
+        return Error::from_string_literal("Profile names may only contain lowercase ASCII letters, digits, '_' and '-'");
+    if (!named_profile_exists(roots, name))
+        return Error::from_string_literal("The profile does not exist");
+    return write_primary_profile_name(roots, name);
+}
