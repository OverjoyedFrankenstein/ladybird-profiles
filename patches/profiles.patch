+static void write_pid_file(WebView::ProfileRoots const& roots, StringView name, pid_t pid)
+{
+    auto pid_path = LexicalPath::join(roots.runtime, "Ladybird/Profiles"sv, name, "Ladybird.pid"sv).string();
+    auto file = MUST(Core::File::open(pid_path, Core::File::OpenMode::Write | Core::File::OpenMode::Truncate));
+    auto contents = ByteString::number(pid);
+    MUST(file->write_until_depleted(contents.bytes()));
+}
+
+TEST_CASE(named_profile_rename)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+    (void)MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+
+    // What the profile holds moves with it.
+    auto settings_path = LexicalPath::join(profile_roots.config, "Ladybird/Profiles/work/Settings.json"sv).string();
+    MUST(MUST(Core::File::open(settings_path, Core::File::OpenMode::Write))->write_until_depleted("{}"sv.bytes()));
+
+    MUST(WebView::Profile::rename_named_profile(profile_roots, "work"sv, "office"sv));
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "office", "personal" }));
+    EXPECT(FileSystem::exists(LexicalPath::join(profile_roots.config, "Ladybird/Profiles/office/Settings.json"sv).string()));
+    for (auto const& root : { profile_roots.config, profile_roots.data, profile_roots.cache, profile_roots.runtime })
+        EXPECT(!FileSystem::exists(LexicalPath::join(root, "Ladybird/Profiles/work"sv).string()));
+
+    // Another profile's name, a name that could not be a profile's, and a profile that does not exist are refused.
+    EXPECT(WebView::Profile::rename_named_profile(profile_roots, "office"sv, "personal"sv).is_error());
+    EXPECT(WebView::Profile::rename_named_profile(profile_roots, "office"sv, "Has Spaces"sv).is_error());
+    EXPECT(WebView::Profile::rename_named_profile(profile_roots, "missing"sv, "found"sv).is_error());
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "office", "personal" }));
+    remove_test_root();
+}
+
+TEST_CASE(named_profile_removal)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+    (void)MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+
+    MUST(WebView::Profile::remove_named_profile(profile_roots, "work"sv));
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "personal" }));
+    for (auto const& root : { profile_roots.config, profile_roots.data, profile_roots.cache, profile_roots.runtime })
+        EXPECT(!FileSystem::exists(LexicalPath::join(root, "Ladybird/Profiles/work"sv).string()));
+
+    EXPECT(WebView::Profile::remove_named_profile(profile_roots, "work"sv).is_error());
+    remove_test_root();
+}
+
+TEST_CASE(profiles_in_use_are_not_changed)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+    (void)MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    EXPECT(!MUST(WebView::Profile::is_named_profile_in_use(profile_roots, "work"sv)));
+
+    // A running Ladybird has its PID in the profile. This process stands in for it.
+    write_pid_file(profile_roots, "work"sv, Core::System::getpid());
+    EXPECT(MUST(WebView::Profile::is_named_profile_in_use(profile_roots, "work"sv)));
+    EXPECT_EQ(WebView::Profile::browser_process_of_named_profile(profile_roots, "work"sv), Optional<i32> { Core::System::getpid() });
+    EXPECT(WebView::Profile::rename_named_profile(profile_roots, "work"sv, "office"sv).is_error());
+    EXPECT(WebView::Profile::remove_named_profile(profile_roots, "work"sv).is_error());
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "work" }));
+
+    // A Ladybird that crashed leaves its PID file behind, which doesn't keep the profile in use.
+    auto child = MUST(Core::Process::spawn("/usr/bin/true"sv, ReadonlySpan<ByteString> {}));
+    auto child_pid = child.pid();
+    (void)MUST(child.wait_for_termination());
+    write_pid_file(profile_roots, "work"sv, child_pid);
+    EXPECT(!MUST(WebView::Profile::is_named_profile_in_use(profile_roots, "work"sv)));
+    EXPECT(!WebView::Profile::browser_process_of_named_profile(profile_roots, "work"sv).has_value());
+
+    // A Ladybird that is starting with the profile holds its startup lock.
+    auto lock_path = LexicalPath::join(profile_roots.runtime, "Ladybird/Profiles/work/startup.lock"sv).string();
+    auto lock_file = MUST(Core::File::open(lock_path, Core::File::OpenMode::ReadWrite));
+    EXPECT_EQ(flock(lock_file->fd(), LOCK_EX | LOCK_NB), 0);
+    EXPECT(MUST(WebView::Profile::is_named_profile_in_use(profile_roots, "work"sv)));
+    EXPECT(WebView::Profile::remove_named_profile(profile_roots, "work"sv).is_error());
+    lock_file->close();
+
+    MUST(WebView::Profile::remove_named_profile(profile_roots, "work"sv));
+    EXPECT(MUST(WebView::Profile::named_profiles(profile_roots)).is_empty());
+    remove_test_root();
+}
+
+TEST_CASE(profiles_deleted_while_open_are_removed_once_closed)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+    (void)MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+
+    // The profile is open, and is deleted from its own window.
+    write_pid_file(profile_roots, "work"sv, Core::System::getpid());
+    MUST(WebView::Profile::mark_named_profile_for_removal(profile_roots, "work"sv));
+    EXPECT(WebView::Profile::is_named_profile_marked_for_removal(profile_roots, "work"sv));
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "personal" }));
+
+    // It stays while it is open.
+    EXPECT_EQ(WebView::Profile::remove_named_profiles_marked_for_removal(profile_roots), 0u);
+    EXPECT(FileSystem::exists(LexicalPath::join(profile_roots.data, "Ladybird/Profiles/work"sv).string()));
+
+    // Once it was closed, it goes, and the profiles that weren't deleted stay.
+    MUST(FileSystem::remove(LexicalPath::join(profile_roots.runtime, "Ladybird/Profiles/work/Ladybird.pid"sv).string(), FileSystem::RecursionMode::Disallowed));
+    EXPECT_EQ(WebView::Profile::remove_named_profiles_marked_for_removal(profile_roots), 1u);
+    for (auto const& root : { profile_roots.config, profile_roots.data, profile_roots.cache, profile_roots.runtime })
+        EXPECT(!FileSystem::exists(LexicalPath::join(root, "Ladybird/Profiles/work"sv).string()));
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "personal" }));
+
+    // Opening a marked profile by name keeps it.
+    MUST(WebView::Profile::mark_named_profile_for_removal(profile_roots, "personal"sv));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+    EXPECT(!WebView::Profile::is_named_profile_marked_for_removal(profile_roots, "personal"sv));
+    EXPECT_EQ(WebView::Profile::remove_named_profiles_marked_for_removal(profile_roots), 0u);
+    EXPECT_EQ(MUST(WebView::Profile::named_profiles(profile_roots)), (Vector<ByteString> { "personal" }));
+    remove_test_root();
+}
+
+TEST_CASE(primary_profile)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+
+    // The default profile is primary until another is made primary.
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), WebView::DEFAULT_PROFILE_NAME);
+
+    // Only a profile that exists can be made primary.
+    EXPECT(WebView::Profile::set_primary_profile_name(profile_roots, "work"sv).is_error());
+    EXPECT(WebView::Profile::set_primary_profile_name(profile_roots, "../work"sv).is_error());
+
+    (void)MUST(WebView::Profile::create({ .name = "work" }, profile_roots));
+    (void)MUST(WebView::Profile::create({ .name = "personal" }, profile_roots));
+
+    MUST(WebView::Profile::set_primary_profile_name(profile_roots, "work"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), "work"sv);
+
+    // A primary profile that is renamed stays primary.
+    MUST(WebView::Profile::rename_named_profile(profile_roots, "work"sv, "office"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), "office"sv);
+
+    // A profile to be deleted once it is closed is no longer primary, and can't be made primary.
+    MUST(WebView::Profile::mark_named_profile_for_removal(profile_roots, "office"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), WebView::DEFAULT_PROFILE_NAME);
+    EXPECT(WebView::Profile::set_primary_profile_name(profile_roots, "office"sv).is_error());
+    MUST(WebView::Profile::unmark_named_profile_for_removal(profile_roots, "office"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), "office"sv);
+
+    // Once the primary profile is deleted, the default profile is primary, even if a profile of that name is created again.
+    MUST(WebView::Profile::remove_named_profile(profile_roots, "office"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), WebView::DEFAULT_PROFILE_NAME);
+    (void)MUST(WebView::Profile::create({ .name = "office" }, profile_roots));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), WebView::DEFAULT_PROFILE_NAME);
+
+    // Deleting a profile that isn't primary leaves the primary profile be.
+    MUST(WebView::Profile::set_primary_profile_name(profile_roots, "personal"sv));
+    MUST(WebView::Profile::remove_named_profile(profile_roots, "office"sv));
+    EXPECT_EQ(WebView::Profile::primary_profile_name(profile_roots), "personal"sv);
+    remove_test_root();
+}
