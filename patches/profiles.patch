diff --git a/Base/res/ladybird/about-pages/settings/profiles.js b/Base/res/ladybird/about-pages/settings/profiles.js
new file mode 100644
index 0000000000000000000000000000000000000000..f6e07775af96170292941132d3df98ad40125634
--- /dev/null
+++ b/Base/res/ladybird/about-pages/settings/profiles.js
@@ -0,0 +1,493 @@
+const profilesTabButton = document.querySelector("#tab-button-profiles");
+const profilesList = document.querySelector("#profiles-list");
+const profilesStatus = document.querySelector("#profiles-status");
+const createProfile = document.querySelector("#create-profile");
+
+const actionsMenu = document.querySelector("#profile-actions-menu");
+const actionPrimary = document.querySelector("#profile-action-primary");
+const actionClose = document.querySelector("#profile-action-close");
+const actionRename = document.querySelector("#profile-action-rename");
+const actionDelete = document.querySelector("#profile-action-delete");
+
+const nameDialog = document.querySelector("#profile-name-dialog");
+const nameTitle = document.querySelector("#profile-name-title");
+const nameClose = document.querySelector("#profile-name-close");
+const nameInput = document.querySelector("#profile-name-input");
+const nameError = document.querySelector("#profile-name-error");
+const nameSave = document.querySelector("#profile-name-save");
+
+const switchDialog = document.querySelector("#profile-switch-dialog");
+const switchClose = document.querySelector("#profile-switch-close");
+const switchTitle = document.querySelector("#profile-switch-title");
+const switchMessage = document.querySelector("#profile-switch-message");
+const switchList = document.querySelector("#profile-switch-list");
+const switchError = document.querySelector("#profile-switch-error");
+const switchCancel = document.querySelector("#profile-switch-cancel");
+const switchCreate = document.querySelector("#profile-switch-create");
+
+const removeDialog = document.querySelector("#profile-remove-dialog");
+const removeClose = document.querySelector("#profile-remove-close");
+const removeMessage = document.querySelector("#profile-remove-message");
+const removeError = document.querySelector("#profile-remove-error");
+const removeCancel = document.querySelector("#profile-remove-cancel");
+const removeConfirm = document.querySelector("#profile-remove-confirm");
+
+// Profile names become the names of directories, so they are limited to what every file system accepts.
+const PROFILE_NAME_PATTERN = /^[a-z0-9_-]+$/;
+
+let PROFILES = [];
+
+// The profile being renamed, or null while a profile is being created.
+let renamingProfile = null;
+let removingProfile = null;
+// The operation whose result the open dialog waits for.
+let pendingOperation = null;
+// The profile last asked to open, whose result is shown below the list.
+let pendingOpen = null;
+// The profile last asked to close, whose result is shown below the list or in the switch dialog.
+let pendingClose = null;
+// The profile last asked to become primary, whose result is shown below the list.
+let pendingPrimary = null;
+
+const asSentence = text => (/[.!?]$/.test(text) ? text : `${text}.`);
+
+const showMessage = (element, text) => {
+    element.textContent = text ? asSentence(text) : "";
+    element.hidden = !text;
+};
+
+function createProfileRow(profile) {
+    const row = document.createElement("div");
+
+    const tile = document.createElement("span");
+    tile.className = "letter-tile";
+    tile.setAttribute("aria-hidden", "true");
+    tile.textContent = profile.name.charAt(0).toUpperCase();
+
+    const name = document.createElement("span");
+    name.className = "item-name";
+    name.textContent = profile.name;
+
+    const notes = [];
+    if (profile.primary) notes.push("Primary");
+    if (profile.current) notes.push("This profile");
+    else if (profile.inUse) notes.push("Open in another window");
+    if (notes.length > 0) {
+        const description = document.createElement("span");
+        description.className = "description";
+        description.textContent = notes.join(" · ");
+        name.appendChild(description);
+    }
+
+    const open = document.createElement("button");
+    open.className = "link-button";
+    open.textContent = "Open";
+    open.setAttribute("aria-label", `Open ${profile.name} in a new window`);
+    open.addEventListener("click", () => {
+        pendingOpen = profile.name;
+        ladybird.sendMessage("openProfile", { name: profile.name });
+    });
+
+    // Making primary, closing, renaming and deleting are kept behind a menu, so that they aren't chosen by accident.
+    const settings = document.createElement("button");
+    settings.className = "menu-toggle profile-settings-button";
+    settings.innerHTML = gearSVG;
+    settings.setAttribute("aria-label", `More options for ${profile.name}`);
+    settings.setAttribute("aria-haspopup", "menu");
+    settings.setAttribute("aria-expanded", "false");
+    settings.title = "Make primary, close, rename or delete";
+    settings.addEventListener("click", event => {
+        event.stopPropagation();
+        if (menuProfile === profile && !actionsMenu.classList.contains("hidden")) closeActionsMenu();
+        else openActionsMenu(profile, settings);
+    });
+
+    row.append(tile, name, open, settings);
+    return row;
+}
+
+const gearSVG =
+    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">' +
+    '<path d="M19.18 9.51 L21.77 9.86 L21.77 14.14 L19.18 14.49 L18.84 15.32 L20.42 17.39 L17.39 20.42 L15.32 18.84 ' +
+    "L14.49 19.18 L14.14 21.77 L9.86 21.77 L9.51 19.18 L8.68 18.84 L6.61 20.42 L3.58 17.39 L5.16 15.32 L4.82 14.49 " +
+    "L2.23 14.14 L2.23 9.86 L4.82 9.51 L5.16 8.68 L3.58 6.61 L6.61 3.58 L8.68 5.16 L9.51 4.82 L9.86 2.23 L14.14 2.23 " +
+    'L14.49 4.82 L15.32 5.16 L17.39 3.58 L20.42 6.61 L18.84 8.68 Z" />' +
+    '<circle cx="12" cy="12" r="3" /></svg>';
+
+// The profile whose gear opened the menu, and that gear.
+let menuProfile = null;
+let menuAnchor = null;
+
+function openActionsMenu(profile, anchor) {
+    closeActionsMenu();
+    menuProfile = profile;
+    menuAnchor = anchor;
+    anchor.setAttribute("aria-expanded", "true");
+
+    // The primary profile is the one Ladybird starts with, so it can be made primary whether or not it's open.
+    actionPrimary.disabled = profile.primary;
+    actionPrimary.title = profile.primary ? "Ladybird already starts with this profile." : "";
+
+    // A profile can be closed while a Ladybird of this version runs with it. A profile that a Ladybird is running with
+    // can't be renamed or deleted under it.
+    actionClose.disabled = !profile.closable;
+    actionClose.title = profile.closable
+        ? ""
+        : profile.inUse
+          ? "This profile is open in another version of Ladybird. Close it from its own windows."
+          : "This profile isn’t open.";
+    actionRename.disabled = profile.inUse;
+    actionRename.title = !profile.inUse
+        ? ""
+        : profile.current
+          ? "Ladybird is using this profile. Switch to another profile first."
+          : "Close this profile to rename it.";
+    // The profile this window shows is deleted by switching to another one, which closes it first.
+    actionDelete.disabled = profile.inUse && !(profile.current && profile.closable);
+    actionDelete.title = !actionDelete.disabled
+        ? ""
+        : profile.closable
+          ? "Close this profile to delete it."
+          : "This profile is open in another version of Ladybird. Close it from its own windows.";
+
+    // The menu opens below the gear, lined up with its right edge, and above it if there's no room below.
+    actionsMenu.classList.remove("hidden");
+    const anchorRect = anchor.getBoundingClientRect();
+    const menuRect = actionsMenu.getBoundingClientRect();
+    const fitsBelow = anchorRect.bottom + 4 + menuRect.height <= window.innerHeight;
+    actionsMenu.style.top = `${fitsBelow ? anchorRect.bottom + 4 : anchorRect.top - 4 - menuRect.height}px`;
+    actionsMenu.style.left = `${Math.max(8, anchorRect.right - menuRect.width)}px`;
+
+    enabledActionItems()[0]?.focus();
+}
+
+const enabledActionItems = () =>
+    [actionPrimary, actionClose, actionRename, actionDelete].filter(item => !item.disabled);
+
+function closeActionsMenu({ restoreFocus = false } = {}) {
+    if (actionsMenu.classList.contains("hidden")) return;
+    actionsMenu.classList.add("hidden");
+    menuAnchor?.setAttribute("aria-expanded", "false");
+    if (restoreFocus) menuAnchor?.focus();
+    menuProfile = null;
+    menuAnchor = null;
+}
+
+actionClose.addEventListener("click", () => {
+    const profile = menuProfile;
+    closeActionsMenu();
+    if (!profile) return;
+
+    // Closing the profile that this window shows would leave nothing open, so another profile is opened in its place.
+    if (profile.current) {
+        openSwitchDialog(profile);
+        return;
+    }
+    pendingClose = profile.name;
+    ladybird.sendMessage("closeProfile", { name: profile.name });
+});
+
+actionPrimary.addEventListener("click", () => {
+    const profile = menuProfile;
+    closeActionsMenu();
+    if (!profile) return;
+    pendingPrimary = profile.name;
+    ladybird.sendMessage("setPrimaryProfile", { name: profile.name });
+});
+
+actionRename.addEventListener("click", () => {
+    const profile = menuProfile;
+    closeActionsMenu();
+    if (profile) openNameDialog(profile);
+});
+
+actionDelete.addEventListener("click", () => {
+    const profile = menuProfile;
+    closeActionsMenu();
+    if (!profile) return;
+    if (profile.current) openSwitchDialog(profile, { deleting: true });
+    else openRemoveDialog(profile);
+});
+
+actionsMenu.addEventListener("keydown", event => {
+    const items = enabledActionItems();
+    const index = items.indexOf(document.activeElement);
+    if (event.key === "Escape") {
+        event.preventDefault();
+        closeActionsMenu({ restoreFocus: true });
+    } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
+        event.preventDefault();
+        const step = event.key === "ArrowDown" ? 1 : -1;
+        if (items.length > 0) items[(index + step + items.length) % items.length].focus();
+    } else if (event.key === "Tab") {
+        closeActionsMenu();
+    }
+});
+
+document.addEventListener("click", event => {
+    if (!actionsMenu.contains(event.target)) closeActionsMenu();
+});
+// The menu is placed where its gear was, so it goes away once the gear moves.
+window.addEventListener("scroll", () => closeActionsMenu(), true);
+window.addEventListener("resize", () => closeActionsMenu());
+
+function renderProfiles() {
+    closeActionsMenu();
+    profilesList.innerHTML = "";
+
+    if (PROFILES.length === 0) {
+        const placeholder = document.createElement("div");
+        placeholder.className = "description";
+        placeholder.textContent = "No profiles";
+        profilesList.appendChild(placeholder);
+        return;
+    }
+
+    for (const profile of PROFILES) profilesList.appendChild(createProfileRow(profile));
+}
+
+// Switches to another profile, and closes the one this window shows, or deletes it once it was closed.
+function openSwitchDialog(currentProfile, { deleting = false } = {}) {
+    const otherProfiles = PROFILES.filter(profile => profile.name !== currentProfile.name);
+    const verb = deleting ? "delete" : "close";
+
+    switchList.innerHTML = "";
+    showMessage(switchError, null);
+    switchList.hidden = otherProfiles.length === 0;
+    switchCreate.hidden = otherProfiles.length !== 0;
+
+    if (otherProfiles.length === 0) {
+        switchMessage.textContent = `You’re using “${currentProfile.name}”. Create another profile to switch to before you ${verb} it.`;
+    } else if (deleting) {
+        switchMessage.textContent = `You’re using “${currentProfile.name}”, so you need to switch to another profile to delete it. Choose a profile to switch to. “${currentProfile.name}” closes, and its history, bookmarks, settings, cookies and cached files are deleted from this computer. This can’t be undone.`;
+    } else {
+        switchMessage.textContent = `Choose a profile to switch to. “${currentProfile.name}” closes, and its tabs come back when you open it again.`;
+    }
+    switchTitle.textContent = deleting ? `Delete ${currentProfile.name}` : "Switch profile";
+
+    for (const profile of otherProfiles) {
+        const tile = document.createElement("span");
+        tile.className = "letter-tile";
+        tile.setAttribute("aria-hidden", "true");
+        tile.textContent = profile.name.charAt(0).toUpperCase();
+
+        const name = document.createElement("span");
+        name.className = "item-name";
+        name.textContent = profile.name;
+        if (profile.inUse) {
+            const description = document.createElement("span");
+            description.className = "description";
+            description.textContent = "Open in another window";
+            name.appendChild(description);
+        }
+
+        const choose = document.createElement("button");
+        choose.className = "link-button";
+        choose.textContent = deleting ? "Switch and delete" : "Switch";
+        choose.setAttribute(
+            "aria-label",
+            deleting ? `Switch to ${profile.name} and delete ${currentProfile.name}` : `Switch to ${profile.name}`
+        );
+        choose.addEventListener("click", () => {
+            for (const button of switchList.querySelectorAll("button")) button.disabled = true;
+            pendingClose = currentProfile.name;
+            ladybird.sendMessage("closeProfile", {
+                name: currentProfile.name,
+                openInstead: profile.name,
+                removeAfterClose: deleting,
+            });
+        });
+
+        const row = document.createElement("div");
+        row.append(tile, name, choose);
+        switchList.appendChild(row);
+    }
+
+    switchDialog.showModal();
+    setTimeout(() => (otherProfiles.length === 0 ? switchCreate : switchList.querySelector("button"))?.focus());
+}
+
+switchCancel.addEventListener("click", () => switchDialog.close());
+switchClose.addEventListener("click", () => switchDialog.close());
+switchCreate.addEventListener("click", () => {
+    switchDialog.close();
+    openNameDialog();
+});
+
+function profileNameProblem() {
+    const name = nameInput.value;
+
+    if (!name) return null;
+    if (!PROFILE_NAME_PATTERN.test(name)) return "Use only lowercase letters, digits, hyphens and underscores.";
+    if (renamingProfile && name === renamingProfile.name) return null;
+    if (PROFILES.some(profile => profile.name === name)) return `A profile named “${name}” already exists.`;
+    return null;
+}
+
+function updateNameDialog() {
+    const problem = profileNameProblem();
+    showMessage(nameError, problem);
+    nameInput.classList.toggle("error", !!problem);
+
+    const isUnchanged = renamingProfile && nameInput.value === renamingProfile.name;
+    nameSave.disabled = !nameInput.value || !!problem || isUnchanged || pendingOperation !== null;
+}
+
+function openNameDialog(profile = null) {
+    renamingProfile = profile;
+    pendingOperation = null;
+
+    nameTitle.textContent = profile ? `Rename ${profile.name}` : "Create profile";
+    nameSave.textContent = profile ? "Rename" : "Create";
+    nameInput.value = profile ? profile.name : "";
+    updateNameDialog();
+
+    nameDialog.showModal();
+    setTimeout(() => {
+        nameInput.focus();
+        nameInput.select();
+    });
+}
+
+function saveProfileName() {
+    if (nameSave.disabled) return;
+
+    if (renamingProfile) {
+        pendingOperation = "rename";
+        ladybird.sendMessage("renameProfile", { name: renamingProfile.name, newName: nameInput.value });
+    } else {
+        pendingOperation = "create";
+        ladybird.sendMessage("createProfile", { name: nameInput.value });
+    }
+    updateNameDialog();
+}
+
+function openRemoveDialog(profile) {
+    removingProfile = profile;
+    pendingOperation = null;
+
+    removeMessage.textContent = `Delete the profile “${profile.name}”? Its history, bookmarks, settings, cookies and cached files are deleted from this computer. This can’t be undone.`;
+    showMessage(removeError, null);
+    removeConfirm.disabled = false;
+
+    removeDialog.showModal();
+    setTimeout(() => removeCancel.focus());
+}
+
+nameInput.addEventListener("input", () => {
+    // Upper case letters are taken as they are typed, as lower case, which is all a profile name may contain.
+    const lowerCaseName = nameInput.value.toLowerCase();
+    if (lowerCaseName !== nameInput.value) {
+        const { selectionStart, selectionEnd } = nameInput;
+        nameInput.value = lowerCaseName;
+        nameInput.setSelectionRange(selectionStart, selectionEnd);
+    }
+    updateNameDialog();
+});
+
+nameInput.addEventListener("keydown", event => {
+    if (event.key === "Enter") saveProfileName();
+});
+
+nameSave.addEventListener("click", saveProfileName);
+nameClose.addEventListener("click", () => nameDialog.close());
+nameDialog.addEventListener("close", () => {
+    renamingProfile = null;
+    if (pendingOperation === "create" || pendingOperation === "rename") pendingOperation = null;
+});
+
+removeConfirm.addEventListener("click", () => {
+    if (!removingProfile) return;
+    pendingOperation = "remove";
+    removeConfirm.disabled = true;
+    ladybird.sendMessage("removeProfile", { name: removingProfile.name });
+});
+
+removeCancel.addEventListener("click", () => removeDialog.close());
+removeClose.addEventListener("click", () => removeDialog.close());
+removeDialog.addEventListener("close", () => {
+    removingProfile = null;
+    if (pendingOperation === "remove") pendingOperation = null;
+});
+
+createProfile.addEventListener("click", () => openNameDialog());
+
+// Profiles can be created, renamed or opened by another Ladybird at any time, so the list is read again when shown.
+profilesTabButton.addEventListener("click", () => ladybird.sendMessage("loadProfiles"));
+
+function handleProfileResult(result) {
+    if (result.operation === "load") {
+        showMessage(profilesStatus, result.error ? `Could not list the profiles: ${result.error}` : null);
+        return;
+    }
+
+    if (result.operation === "open") {
+        if (pendingOpen === null) return;
+        const name = pendingOpen;
+        pendingOpen = null;
+        showMessage(profilesStatus, result.error ? `Could not open “${name}”: ${result.error}` : null);
+        // The profile is in use once its Ladybird has started, which takes a moment.
+        if (!result.error) setTimeout(() => ladybird.sendMessage("loadProfiles"), 2000);
+        return;
+    }
+
+    if (result.operation === "primary") {
+        if (pendingPrimary === null) return;
+        const name = pendingPrimary;
+        pendingPrimary = null;
+        showMessage(profilesStatus, result.error ? `Could not make “${name}” primary: ${result.error}` : null);
+        return;
+    }
+
+    if (result.operation === "close") {
+        if (pendingClose === null) return;
+        const name = pendingClose;
+        pendingClose = null;
+        if (switchDialog.open) {
+            // On success, this window closes along with its profile.
+            if (result.error) {
+                showMessage(switchError, result.error);
+                for (const button of switchList.querySelectorAll("button")) button.disabled = false;
+            }
+            return;
+        }
+        showMessage(profilesStatus, result.error ? `Could not close “${name}”: ${result.error}` : null);
+        // The profile is no longer in use once its Ladybird has saved its windows and ended, which takes a moment.
+        if (!result.error) setTimeout(() => ladybird.sendMessage("loadProfiles"), 2000);
+        return;
+    }
+
+    if (result.operation !== pendingOperation) return;
+    pendingOperation = null;
+
+    if (result.operation === "remove") {
+        if (result.error) {
+            showMessage(removeError, result.error);
+            removeConfirm.disabled = false;
+        } else {
+            removeDialog.close();
+        }
+        return;
+    }
+
+    if (result.error) {
+        updateNameDialog();
+        showMessage(nameError, result.error);
+    } else {
+        nameDialog.close();
+    }
+}
+
+document.addEventListener("WebUILoaded", () => {
+    ladybird.sendMessage("loadProfiles");
+});
+
+document.addEventListener("WebUIMessage", event => {
+    if (event.detail.name === "loadProfiles") {
+        PROFILES = event.detail.data.profiles || [];
+        renderProfiles();
+        if (nameDialog.open) updateNameDialog();
+    } else if (event.detail.name === "profileResult") {
+        handleProfileResult(event.detail.data);
+    }
+});
