+// The executable that a process runs, as a canonical path.
+static Optional<ByteString> executable_of_process([[maybe_unused]] i32 pid)
+{
+#if defined(AK_OS_MACOS)
+    char path[PROC_PIDPATHINFO_MAXSIZE];
+    if (proc_pidpath(pid, path, sizeof(path)) <= 0)
+        return {};
+    auto real_path = FileSystem::real_path(StringView { path, strlen(path) });
+    return real_path.is_error() ? Optional<ByteString> {} : real_path.release_value();
+#elif defined(AK_OS_LINUX)
+    auto real_path = FileSystem::real_path(ByteString::formatted("/proc/{}/exe", pid));
+    return real_path.is_error() ? Optional<ByteString> {} : real_path.release_value();
+#else
+    return {};
+#endif
+}
+
+// Whether the Ladybird running with a profile can be asked to close and keep its windows. That Ladybird has to be this
+// version, as an older one would take the request to be a signal to end at once, and lose its windows.
+static bool can_close_browser_process(i32 pid)
+{
+#if defined(AK_OS_WINDOWS)
+    // FIXME: Ask the Ladybird of another profile to close on Windows, which has no signals to ask it with.
+    (void)pid;
+    return false;
+#else
+    auto executable = Core::System::current_executable_path();
+    if (executable.is_error())
+        return false;
+    auto real_executable = FileSystem::real_path(executable.value());
+    auto executable_of_pid = executable_of_process(pid);
+    return !real_executable.is_error() && executable_of_pid.has_value() && *executable_of_pid == real_executable.value();
+#endif
+}
+
+void SettingsUI::load_profiles()
+{
+    JsonArray profiles;
+
+    struct RootsAndNames {
+        ProfileRoots roots;
+        Vector<ByteString> names;
+    };
+    auto roots_and_names = [&]() -> ErrorOr<RootsAndNames> {
+        auto roots = TRY(Profile::platform_roots());
+        (void)Profile::remove_named_profiles_marked_for_removal(roots);
+        auto names = TRY(Profile::named_profiles(roots));
+        return RootsAndNames { move(roots), move(names) };
+    }();
+    if (roots_and_names.is_error()) {
+        report_profile_result("load"sv, roots_and_names.release_error());
+        return;
+    }
+    auto [roots, names] = roots_and_names.release_value();
+
+    auto const& current_identity = Application::profile().paths().identity;
+    auto primary_name = Profile::primary_profile_name(roots);
+    for (auto const& name : names) {
+        auto identity = Profile::identity_of_named_profile(roots, name);
+        auto is_current = !identity.is_error() && identity.value() == current_identity;
+        // NB: A profile whose use cannot be found out is taken to be in use, so that it is not changed.
+        auto in_use = Profile::is_named_profile_in_use(roots, name);
+        auto is_in_use = is_current || in_use.is_error() || in_use.value();
+
+        JsonObject profile;
+        profile.set("name"sv, String::from_byte_string(name).release_value_but_fixme_should_propagate_errors());
+        profile.set("current"sv, is_current);
+        profile.set("inUse"sv, is_in_use);
+        profile.set("primary"sv, name == primary_name);
+        auto pid = Profile::browser_process_of_named_profile(roots, name);
+        profile.set("closable"sv, pid.has_value() && can_close_browser_process(*pid));
+        profiles.must_append(move(profile));
+    }
+
+    JsonObject result;
+    result.set("profiles"sv, move(profiles));
+    async_send_message("loadProfiles"sv, move(result));
+}
+
+static Optional<ByteString> profile_name_from(JsonValue const& data, StringView key)
+{
+    if (!data.is_object())
+        return {};
+    auto name = data.as_object().get_string(key);
+    if (!name.has_value())
+        return {};
+    return name->to_byte_string();
+}
+
+void SettingsUI::open_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    if (!name.has_value())
+        return;
+
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        if (!TRY(Profile::named_profiles(roots)).contains_slow(*name))
+            return Error::from_string_literal("The profile does not exist");
+        Application::the().open_profile(*name);
+        return {};
+    }();
+    report_profile_result("open"sv, move(result));
+}
+
+void SettingsUI::close_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    if (!name.has_value())
+        return;
+    // A Ladybird that closes the profile it runs with opens another one first, so that a window stays open.
+    auto profile_to_open = profile_name_from(data, "openInstead"sv);
+    // A profile that is deleted while it is open is marked, and removed once it was closed.
+    auto removes_after_close = data.as_object().get_bool("removeAfterClose"sv).value_or(false);
+
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        auto names = TRY(Profile::named_profiles(roots));
+        if (!names.contains_slow(*name))
+            return Error::from_string_literal("The profile does not exist");
+        if (profile_to_open.has_value() && (*profile_to_open == *name || !names.contains_slow(*profile_to_open)))
+            return Error::from_string_literal("The profile to switch to does not exist");
+
+        auto pid = Profile::browser_process_of_named_profile(roots, *name);
+        if (!pid.has_value())
+            return Error::from_string_literal("The profile is not open");
+        if (!can_close_browser_process(*pid))
+            return Error::from_string_literal("The profile is open in another version of Ladybird. Close it from its own windows");
+
+        if (removes_after_close)
+            TRY(Profile::mark_named_profile_for_removal(roots, *name));
+
+        // NB: The UI opens the other profile before it hears that it is to close, as messages to it arrive in order.
+        if (profile_to_open.has_value())
+            Application::the().open_profile(*profile_to_open);
+#if !defined(AK_OS_WINDOWS)
+        if (auto result = Core::System::kill(*pid, SIGUSR1); result.is_error()) {
+            if (removes_after_close)
+                (void)Profile::unmark_named_profile_for_removal(roots, *name);
+            return result.release_error();
+        }
+#endif
+        return {};
+    }();
+    report_profile_result("close"sv, move(result));
+}
+
+void SettingsUI::create_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    if (!name.has_value())
+        return;
+
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        if (TRY(Profile::named_profiles(roots)).contains_slow(*name))
+            return Error::from_string_literal("A profile with that name already exists");
+        // NB: Creating the profile would take the mark away from one that was deleted while it was open, and keep it.
+        if (Profile::is_named_profile_marked_for_removal(roots, *name) && Profile::remove_named_profile(roots, *name).is_error())
+            return Error::from_string_literal("A profile with that name is still being deleted. Try again in a moment");
+        (void)TRY(Profile::create({ .name = *name }, roots));
+        return {};
+    }();
+    report_profile_result("create"sv, move(result));
+}
+
+void SettingsUI::rename_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    auto new_name = profile_name_from(data, "newName"sv);
+    if (!name.has_value() || !new_name.has_value())
+        return;
+
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        return Profile::rename_named_profile(roots, *name, *new_name);
+    }();
+    report_profile_result("rename"sv, move(result));
+}
+
+void SettingsUI::remove_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    if (!name.has_value())
+        return;
+
+    // NB: The profile Ladybird is running with is in use, and is refused below. Checking it here as well keeps a
+    //     profile from being removed under this Ladybird if its PID file could not be read.
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        auto identity = Profile::identity_of_named_profile(roots, *name);
+        if (!identity.is_error() && identity.value() == Application::profile().paths().identity)
+            return Error::from_string_literal("The profile is in use. Close the Ladybird that is using it first");
+        return Profile::remove_named_profile(roots, *name);
+    }();
+    report_profile_result("remove"sv, move(result));
+}
+
+void SettingsUI::set_primary_profile(JsonValue const& data)
+{
+    auto name = profile_name_from(data, "name"sv);
+    if (!name.has_value())
+        return;
+
+    auto result = [&]() -> ErrorOr<void> {
+        auto roots = TRY(Profile::platform_roots());
+        return Profile::set_primary_profile_name(roots, *name);
+    }();
+    report_profile_result("primary"sv, move(result));
+}
+
+void SettingsUI::report_profile_result(StringView operation, ErrorOr<void> result)
+{
+    JsonObject report;
+    report.set("operation"sv, String::from_utf8_without_validation(operation.bytes()));
+    if (result.is_error())
+        report.set("error"sv, MUST(String::formatted("{}", result.error())));
+    async_send_message("profileResult"sv, move(report));
+
+    if (operation != "load"sv)
+        load_profiles();
+}
+
 }
